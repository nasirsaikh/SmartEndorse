DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=
DEFAULT_FROM_EMAIL=smartendorse@example.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Provider secrets: enter these variable names in AI Provider Config > Secret reference.
HF_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# IMAP/SMTP. Credentials belong in the environment; configure their variable names in Admin.
ENDORSEMENT_IMAP_PASSWORD=
EMAIL_TIMEOUT=30

# Microsoft 365 application credential; tenant/client IDs and mailbox are configured in Admin.
ENDORSEMENT_GRAPH_CLIENT_SECRET=
