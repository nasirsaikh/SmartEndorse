DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=
DEFAULT_FROM_EMAIL=smartendorse@example.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Provider secrets: enter these variable names in AI Provider Config > Secret reference.
HF_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Mailbox IMAP/Graph credentials and reply SMTP settings are configured in Admin.
EMAIL_TIMEOUT=30

# APScheduler: DEBUG/runserver autostarts by default. Use 0 with the dedicated worker.
# Leave AUTOSTART unset for that default; set it to 1 to enable embedding in production.
# EMAIL_INTAKE_AUTOSTART=1
EMAIL_INTAKE_POLL_SECONDS=30
EMAIL_INTAKE_BATCH_SIZE=50
# Optional shared lock path; empty defaults to media/email-intake-poll.lock.
EMAIL_INTAKE_LOCK_FILE=
